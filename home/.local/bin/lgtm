#!/usr/bin/env bash
# Generate commit message from diff using Codex

diff=$(git diff --cached)
[ -z "$diff" ] && diff=$(git diff)
[ -z "$diff" ] && echo "no changes" && exit 1

prompt="Write a one-line commit message for the provided git diff.
Use conventional commit format.
Return only the commit message. No markdown, backticks, quotes, explanation, or preamble."

msg_file=$(mktemp)
log_file=$(mktemp)
cleanup() {
  rm -f "$msg_file" "$log_file"
}
trap cleanup EXIT

if ! printf "%s\n" "$diff" | codex exec \
  --model gpt-5.3-codex-spark \
  --sandbox read-only \
  --ephemeral \
  --output-last-message "$msg_file" \
  "$prompt" >"$log_file" 2>&1; then
  echo "failed to generate commit message with codex"
  cat "$log_file"
  exit 1
fi

msg=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' "$msg_file")

if [[ -z "$msg" ]]; then
  echo "failed to generate commit message with codex"
  cat "$log_file"
  exit 1
fi

echo "$msg"
if [[ "$1" == "-y" ]]; then
  git commit -m "$msg"
else
  read -p "commit? [y/N] " -n 1 -r
  echo
  [[ $REPLY =~ ^[Yy]$ ]] && git commit -m "$msg"
fi
